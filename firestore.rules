rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user may only read/write their own login record, and only these fields.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','uid','authMethod','sessionId','lastLogin'])
        && request.resource.data.uid == uid
        && request.resource.data.lastLogin == request.time
        && request.resource.data.authMethod in ['email','email_verified','google','github','access_code']
        && request.resource.data.email == (('email' in request.auth.token) ? request.auth.token.email : 'Anonymous');
      allow delete: if false;
    }
    // Everything else (including _rateLimits) is server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
